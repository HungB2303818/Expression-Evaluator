<Window x:Class="ExpressionEvaluator.Views.GrammarDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Văn phạm phi ngữ cảnh (CFG)" Width="650" Height="460"
        MinWidth="460" MinHeight="320" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Văn phạm cố định · ε biểu diễn chuỗi rỗng"
                   Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,12" />
        <TextBox Grid.Row="1" Text="{Binding GrammarText, Mode=OneWay}" IsReadOnly="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"
                 FontSize="14" Padding="12" />
        <Button Grid.Row="2" Content="Đóng" HorizontalAlignment="Right"
                Margin="0,14,0,0" IsCancel="True" Click="Close_Click" />
    </Grid>
</Window>
